{
    "compilerOptions": {
        "module": "es2022",
        "target": "es2022",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["./**/*.js", "./**/*.ts"],
    "exclude": ["**/*.now.ts"]
}
